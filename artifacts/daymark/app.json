{
  "expo": {
    "name": "Daymark",
    "slug": "daymark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daymark",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aghaasif.daymark"
    },
    "android": {
      "package": "com.aghaasif.daymark",
      "versionCode": 1,
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "splash": {
      "backgroundColor": "#f7f4ed",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router", ["expo-notifications", { "color": "#ef765e" }]],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
